<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Produces solve.exe, as required by the project brief. -->
    <AssemblyName>solve</AssemblyName>
    <RootNamespace>Solve</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Keeps the sample models next to the exe so the demo video can load them by name. -->
    <NoWarn>$(NoWarn);CS0067</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\samples\*.txt" CopyToOutputDirectory="PreserveNewest" LinkBase="samples" />
  </ItemGroup>

</Project>
